# REQUIRED — change all of these before deploying to production

PORT=5001
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/bold_pieces?retryWrites=true&w=majority&appName=Boldpieces

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING

# Optional separate secret for customer tokens (recommended in production)
CUSTOMER_JWT_SECRET=CHANGE_THIS_TO_A_DIFFERENT_RANDOM_STRING

# Admin credentials — use a strong password
ADMIN_EMAIL=admin@boldpieces.com
ADMIN_PASSWORD=CHANGE_THIS_BEFORE_DEPLOYING

# Shwary — set SHWARY_SANDBOX=false for production live payments
SHWARY_MERCHANT_ID=b93d2aae-0e61-4d4c-b80b-a75bfab33e4c
SHWARY_MERCHANT_KEY=your_live_key_here
SHWARY_CALLBACK_URL=https://your-api.railway.app/api/shwary/callback
SHWARY_SANDBOX=true

# CORS — set to your production frontend domain (omit or * for local dev)
ALLOWED_ORIGIN=https://your-frontend.vercel.app

# Local dev only (optional)
VITE_SHOW_ADMIN_LINK=true
